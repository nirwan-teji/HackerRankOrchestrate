# Copy to .env (gitignored). Never commit keys.
# Provider: groq | openai | anthropic | google_genai | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Vision-capable model (used by orchestrate.vision); leave blank to reuse LLM_MODEL
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0
LLM_SEED=42
# Max requests per minute (free tiers are tight); 0 = unlimited
LLM_RPM=25
LLM_CACHE=1

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Ghost Data audit agent -------------------------------------------------
# Deterministic by default (0 model calls). Set to 1 to let the LangChain model above double-check
# request texts the rules are unsure about (cached, one call per distinct text).
GHOST_LLM_INTENT=0
# Classify every request text, not only the ones the rules flag as unsure (needs GHOST_LLM_INTENT=1)
GHOST_LLM_INTENT_ALL=0
# Let the model choose between equally-compatible resource/case pairings the engine can only guess.
# Its answer is rejected unless it satisfies the same deterministic constraints, so this can refine a
# guess but never introduce a link the evidence rules out.
# Advisory LLM review of risky plans (guessed links, convention accounts, unestablished states).
# It only raises flags; it can never change output.csv. GHOST_REVIEW_SCOPE=risky|all, GHOST_REVIEW_MAX caps the calls.
GHOST_LLM_REVIEW=0
GHOST_REVIEW_SCOPE=risky
GHOST_REVIEW_MAX=0
GHOST_LLM_LINKS=0   # measured: gpt-oss-120b got 1/8 links right vs 7/8 for the positional rule -> leave off
# Optional prices (USD per million tokens) used only to estimate cost in evaluation/usage_report.md
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
