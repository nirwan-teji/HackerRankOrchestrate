# Copy to .env (gitignored). Never commit keys.
# Provider: groq | openai | anthropic | google_genai | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Vision-capable model (used by orchestrate.vision); leave blank to reuse LLM_MODEL
VISION_PROVIDER=groq
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TEMPERATURE=0
LLM_SEED=42
# Max requests per minute (free tiers are tight); 0 = unlimited
LLM_RPM=25
LLM_CACHE=1

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
